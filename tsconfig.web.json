{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "plugins/**/renderer.ts",
    "plugins/**/*.tsx",
    "plugins/agent-overview/overview.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "plugins/**/*.test.tsx"]
}
