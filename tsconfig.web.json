{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@dia/renderer-plugin": ["./src/renderer/src/plugin-api.ts"],
      "@dia/plugin": ["./src/host/plugin-api.ts"],
      "@dia-plugin/*": ["./plugins/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/host/plugin-api.ts",
    "src/host/plugins/host-plugin-context.ts",
    "src/host/services/meta-repo-seam.ts",
    "src/host/services/worktrees-seam.ts",
    "src/host/session/agent-backend.ts",
    "src/host/session/dia-tools.ts",
    "src/host/session/pending-user-input.ts",
    "src/host/session/protocol.ts",
    "src/host/session/start-permission-mode.ts",
    "plugins/**/renderer.ts",
    "plugins/**/*.tsx",
    "plugins/agent-overview/overview.ts",
    "plugins/example/messages.ts",
    "plugins/issues/domain.ts",
    "plugins/issues/service.ts",
    "plugins/issues/tool-input.ts",
    "plugins/org/service.ts",
    "plugins/org/domain.ts",
    "plugins/org/calls.ts",
    "plugins/mcp/servers.ts",
    "plugins/mcp/draft.ts",
    "plugins/mcp/editor.ts",
    "plugins/mcp/registry.ts",
    "plugins/agent-definitions/registry.ts",
    "plugins/mcp/picker.ts",
    "plugins/skills/registry.ts",
    "plugins/skills/directory.ts",
    "plugins/skills/frontmatter.ts",
    "plugins/skills/picker.ts",
    "plugins/skills/calls.ts",
    "plugins/mcp/calls.ts",
    "plugins/worktrees/calls.ts",
    "plugins/issues/calls.ts",
    "plugins/issues/issue-actions.ts",
    "plugins/org/org-view.ts",
    "plugins/org/org-tree.ts",
    "plugins/org/org-actions.ts",
    "plugins/chat/slots.ts",
    "plugins/adapters/slots.ts",
    "plugins/command-palette/slots.ts",
    "plugins/layout/slots.ts",
    "plugins/settings/slots.ts",
    "plugins/chat/composer-action.ts",
    "plugins/chat/attachment-draft.ts",
    "plugins/chat/composer-settings.ts",
    "plugins/chat/context-meter.ts",
    "plugins/chat/slash-command-filter.ts",
    "plugins/chat/token-count.ts",
    "plugins/chat/use-composer-attachments.ts",
    "plugins/chat/use-pane-chat.ts",
    "plugins/chat/use-elapsed-clock.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "plugins/**/*.test.tsx"]
}
