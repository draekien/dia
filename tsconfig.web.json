{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@dia/renderer-plugin": ["./src/renderer/src/plugin-api.ts"],
      "@dia/plugin": ["./src/host/plugin-api.ts"],
      "@dia-plugin/*": ["./plugins/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/host/plugin-api.ts",
    "src/host/plugins/host-plugin-context.ts",
    "src/host/services/meta-repo-seam.ts",
    "src/host/services/run-events-seam.ts",
    "src/host/plugins/plugin-paths.ts",
    "src/host/services/worktrees-seam.ts",
    "src/host/session/agent-backend.ts",
    "src/host/session/dia-tools.ts",
    "src/host/session/pending-user-input.ts",
    "src/host/session/protocol.ts",
    "src/host/session/start-permission-mode.ts",
    "plugins/**/renderer.ts",
    "plugins/**/*.tsx",
    "plugins/dia-agent-overview/overview.ts",
    "plugins/dia-example/messages.ts",
    "plugins/dia-issues/domain.ts",
    "plugins/dia-issues/service.ts",
    "plugins/dia-issues/tool-input.ts",
    "plugins/dia-mcp/servers.ts",
    "plugins/dia-mcp/draft.ts",
    "plugins/dia-mcp/editor.ts",
    "plugins/dia-mcp/registry.ts",
    "plugins/dia-agent-definitions/registry.ts",
    "plugins/dia-mcp/picker.ts",
    "plugins/dia-skills/registry.ts",
    "plugins/dia-skills/directory.ts",
    "plugins/dia-skills/frontmatter.ts",
    "plugins/dia-skills/picker.ts",
    "plugins/dia-run-events/calls.ts",
    "plugins/dia-skills/calls.ts",
    "plugins/dia-mcp/calls.ts",
    "plugins/dia-worktrees/calls.ts",
    "plugins/dia-issues/calls.ts",
    "plugins/dia-issues/issue-actions.ts",
    "plugins/dia-chat/slots.ts",
    "plugins/dia-adapters/slots.ts",
    "plugins/dia-command-palette/slots.ts",
    "plugins/dia-layout/slots.ts",
    "plugins/dia-settings/slots.ts",
    "plugins/dia-chat/composer-action.ts",
    "plugins/dia-chat/attachment-draft.ts",
    "plugins/dia-chat/composer-settings.ts",
    "plugins/dia-chat/context-meter.ts",
    "plugins/dia-chat/slash-command-filter.ts",
    "plugins/dia-chat/token-count.ts",
    "plugins/dia-chat/use-composer-attachments.ts",
    "plugins/dia-chat/use-pane-chat.ts",
    "plugins/dia-chat/use-elapsed-clock.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "plugins/**/*.test.tsx"]
}
