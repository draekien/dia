{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@dia/plugin": ["./src/host/plugin-api.ts"],
      "@dia-plugin/*": ["./plugins/*"],
      "@preload/*": ["./src/preload/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/host/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "plugins/**/*.ts",
    "electron.vite.config.ts",
    "vite/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "plugins/**/*.test.ts",
    "plugins/**/renderer.ts",
    "plugins/issues/issue-actions.ts",
    "plugins/chat/composer-action.ts",
    "plugins/chat/composer-settings.ts",
    "plugins/chat/use-composer-attachments.ts",
    "plugins/chat/use-pane-chat.ts"
  ]
}
