{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@effect/platform-node": "Import a subpath such as '@effect/platform-node/NodeServices'. The package index loads NodeRedis.js, which needs the optional peer 'redis' that the packaged app does not contain."
            }
          }
        }
      },
      "nursery": {
        "useReactCompiler": "warn"
      }
    },
    "domains": {
      "react": "recommended",
      "project": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/host/**", "src/preload/**", "plugins/claude-code/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
