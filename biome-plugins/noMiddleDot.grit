engine biome(1.0)
language js(typescript, jsx)

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement(),
  JsxText()
} as $text where {
  $text <: r"(?si).*(?:·|(?:^|[^\\])(?:\\\\)*\\(?:u00b7|xb7|u\{0*b7\})|&middot;|&#0*183;|&#x0*b7;).*",
  register_diagnostic(span=$text, message="Don't separate text with a middle dot (U+00B7), written as the character or as an escape: use layout spacing, a comma, a colon or a sentence (DESIGN.md, The No Middle Dot Rule). Text shown verbatim from elsewhere may keep it; suppress this rule there with the reason.", severity="error")
}
