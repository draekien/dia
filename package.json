{
  "name": "dia",
  "version": "0.0.10",
  "description": "dia — a personal desktop app that drives a local Claude installation via the Agent SDK",
  "main": "./out/main/index.js",
  "author": "William Pei",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:effect": "./scripts/prepare-effect.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "diagnostics": "pnpm diagnostics:node && pnpm diagnostics:web && pnpm diagnostics:test",
    "diagnostics:node": "effect-tsgo diagnostics --project tsconfig.node.json --format pretty",
    "diagnostics:web": "effect-tsgo diagnostics --project tsconfig.web.json --format pretty",
    "diagnostics:test": "effect-tsgo diagnostics --project tsconfig.test.json --format pretty",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@effect/tsgo": "0.59.0",
    "@effect/vitest": "4.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@effect/atom-react": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "effect": "4.0.6",
    "electron-updater": "6.8.11",
    "highlight.js": "11.12.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-highlight-code-lines": "1.2.5",
    "remark-gfm": "4.0.1",
    "shadcn": "4.22.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
